{
  "name": "@spring-harness/cli",
  "version": "0.1.0",
  "description": "Spring Harness — a personal general-purpose agent runtime (sph)",
  "type": "module",
  "license": "MIT",
  "bin": {
    "sph": "./dist/cli/index.js"
  },
  "exports": {
    ".": "./dist/sdk.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.test.json",
    "pretest": "npm run typecheck",
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "sph": "tsx src/cli/index.ts"
  },
  "dependencies": {
    "get-east-asian-width": "^1.6.0",
    "koffi": "^2.12.1",
    "marked": "^18.0.5",
    "smol-toml": "^1.4.2",
    "undici": "^8.10.2"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
